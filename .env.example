# Copiar en Netlify (Site settings -> Environment variables)
# o en Vercel (Settings -> Environment Variables).
# NUNCA subir este archivo con valores reales al repositorio.

# --- Precios de vuelo -------------------------------------------------
# Motor google_flights. Devuelve el rango tipico de la ruta.
# 250 busquedas gratis al mes; luego $25/mes por 1,000.
SERPAPI_KEY=

# Alternativa gratuita que ademas paga comision de afiliado.
TRAVELPAYOUTS_TOKEN=

# --- Google Maps Platform ---------------------------------------------
# Places API (New) + Routes API. Restringir por dominio y por API
# en la consola de Google Cloud antes de publicar.
GOOGLE_MAPS_KEY=

# --- Supabase ---------------------------------------------------------
# La URL y la clave anon son publicas por diseno: la seguridad la da
# el RLS del schema. La service_role NUNCA va al navegador.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pasarela de pago -------------------------------------------------
# GUMROAD (para cobrar hoy). Genera un token en:
#   Gumroad -> Settings -> Advanced -> Applications -> Generate access token
# Con el token, el webhook verifica cada venta contra la API de Gumroad.
GUMROAD_ACCESS_TOKEN=

# Secreto compartido del webhook. Sirve para dos cosas:
#   1) Respaldo de Gumroad si NO usas token: pon el webhook como
#      https://TU-DOMINIO/api/webhook?key=EL_SECRETO  y el codigo compara "key".
#   2) Firma HMAC de los proveedores Merchant of Record (Polar / Lemon Squeezy).
PAYMENT_WEBHOOK_SECRET=
